set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(OPENDROP_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(OPENDROP_MINGW "${OPENDROP_ROOT}/.tools/mingw/usr")
set(CMAKE_C_COMPILER "${OPENDROP_MINGW}/bin/x86_64-w64-mingw32-gcc")
set(CMAKE_CXX_COMPILER "${OPENDROP_MINGW}/bin/x86_64-w64-mingw32-g++")
set(CMAKE_RC_COMPILER "${OPENDROP_MINGW}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_SYSROOT "${OPENDROP_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}" "${OPENDROP_ROOT}/.tools/qt-windows/6.8.3/mingw_64")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(QT_HOST_PATH "${OPENDROP_ROOT}/.tools/qt-host/6.8.3/gcc_64" CACHE PATH "Matching Linux Qt tools")
